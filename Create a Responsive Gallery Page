<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Gallery</title>

    <style>
        body{
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f4;
        }

        h1{
            text-align: center;
            padding: 20px;
            background: #333;
            color: white;
            margin: 0;
        }

        /* --- Gallery Container --- */
        .gallery{
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            padding: 20px;
            justify-content: center;
        }

        /* --- Gallery Images --- */
        .gallery img{
            width: 300px;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
            transition: transform 0.3s;
        }

        .gallery img:hover{
            transform: scale(1.05);
        }

        /* --- Media Queries for Responsiveness --- */

        /* Tablets */
        @media (max-width: 768px){
            .gallery img{
                width: 45%;
                height: 180px;
            }
        }

        /* Mobile */
        @media (max-width: 480px){
            .gallery img{
                width: 100%;
                height: 180px;
            }
        }
    </style>
</head>
<body>

    <h1>Responsive Image Gallery</h1>

    <div class="gallery">
        <img src="https://picsum.photos/seed/1/400/300" alt="">
        <img src="https://picsum.photos/seed/2/400/300" alt="">
        <img src="https://picsum.photos/seed/3/400/300" alt="">
        <img src="https://picsum.photos/seed/4/400/300" alt="">
        <img src="https://picsum.photos/seed/5/400/300" alt="">
        <img src="https://picsum.photos/seed/6/400/300" alt="">
        <img src="https://picsum.photos/seed/7/400/300" alt="">
        <img src="https://picsum.photos/seed/8/400/300" alt="">
    </div>

</body>
</html>
